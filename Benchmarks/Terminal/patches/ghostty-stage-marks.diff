diff --git a/src/termbench.zig b/src/termbench.zig
new file mode 100644
index 000000000..fde658ed3
--- /dev/null
+++ b/src/termbench.zig
@@ -0,0 +1,6 @@
+//! TERMBENCH PATCH: stage marks for the benchmark harness, which defines termbench_mark
+//! (weakly linked, so anything else built from this tree links without it).
+const f = @extern(?*const fn (u32) callconv(.c) void, .{ .name = "termbench_mark", .linkage = .weak });
+pub inline fn mark(id: u32) void {
+    if (f) |g| g(id);
+}
